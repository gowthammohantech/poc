POPPLER_PATH=
STORAGE_BASE=storage/uploads
DB_PATH=invoice_ocr.db
FRONTEND_URL=http://localhost:3000
MASTRA_SERVICE_URL=http://localhost:4111
# --- Connectors ---
BACKEND_PUBLIC_URL=http://localhost:8000
# Fill these in from Google Cloud Console (see README) to enable Gmail.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/connectors/gmail/oauth/callback
# base64 of 32 random bytes; without it OAuth tokens are stored in plaintext.
CONNECTOR_TOKEN_SECRET=
CONNECTOR_MAX_ATTACHMENT_MB=15
CONNECTOR_MIN_ATTACHMENT_KB=20
CONNECTOR_MAX_MESSAGES_PER_SYNC=25
